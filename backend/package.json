{
  "name": "@habitus/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "keys:generate": "node scripts/generate-keys.js",
    "db:migrate": "knex migrate:latest --knexfile knexfile.js",
    "db:rollback": "knex migrate:rollback --knexfile knexfile.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.11",
    "knex": "^3.1.0",
    "mysql2": "^3.14.1",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "supertest": "^7.1.1",
    "vitest": "^4.1.9"
  }
}
